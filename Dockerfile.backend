FROM python:3.10-slim

WORKDIR /app

# Instala git e dependências do sistema necessárias para compilar o MySQL
RUN apt-get update && apt-get install -y git gcc default-libmysqlclient-dev pkg-config && rm -rf /var/lib/apt/lists/*

# Clona o repositório do backend diretamente do GitHub (substitua pela URL correta se necessário)
RUN git clone https://github.com/luisaanny74-a11y/Backend-Clinica-Odonto.git .

# Instala as dependências do Python
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]