# Estágio 1: Baixa o código do GitHub e faz o build da aplicação Flutter Web
FROM ghcr.io/cirruslabs/flutter:3.19.0 AS build
WORKDIR /app

# Instala git se necessário e clona o repositório do frontend (substitua pela URL correta)
RUN git clone https://github.com/marizabelkk/Frontend-Clinica-Odonto.git .

RUN flutter pub get
RUN flutter build web --release

# Estágio 2: Servir a aplicação compilada com Nginx
FROM nginx:alpine
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]